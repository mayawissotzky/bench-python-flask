<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ team.name }} - expenses</title>
  <style>
    body { font-family: sans-serif; margin: 2rem; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border-bottom: 1px solid #ccc; padding: .4rem; text-align: left; }
    .num { text-align: right; }
    @media print { .no-print { display: none; } }
  </style>
</head>
<body>
  <h1>{{ team.name }}</h1>
  <p>{{ items|length }} expense(s){% if status %}, status: {{ status }}{% endif %}</p>
  <button class="no-print" onclick="window.print()">Print</button>
  <table>
    <thead><tr><th>Date</th><th>Member</th><th>Description</th><th>Category</th><th class="num">Amount</th><th>Status</th></tr></thead>
    <tbody>
    {% for e in items %}
      <tr>
        <td>{{ e.spent_on }}</td>
        <td>{{ e.owner.name }}</td>
        <td>{{ e.description }}</td>
        <td>{{ e.category }}</td>
        <td class="num">{{ e.amount|money(e.currency) }}</td>
        <td>{{ e.status }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</body>
</html>
